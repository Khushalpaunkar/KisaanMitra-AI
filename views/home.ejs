                            <p>
                                Rain is expected tomorrow.
                                Spraying may be less effective.
                            </p>

                        </div>

                    </div>


                    <!-- ADVICE 2 -->

                    <div class="advice-card">

                        <div class="advice-icon">
                            💧
                        </div>

                        <div class="advice-content">

                            <h4>
                                Reduce irrigation

                    </div>

                </div>


                <div class="weather-point">

                    <div class="weather-point-icon">
                        🌡️
                    </div>

                    <div>
                        <h4>Too Hot?</h4>

                        <p>
                            Get alerts when heat may affect your crops.
                        </p>
                    </div>

                </div>


                <div class="weather-point">

                    <div class="weather-point-icon">
                        🌱
                    </div>

                    <div>
                        <h4>Good Day for Farm Work?</h4>

                        <p>
                            Find the right time for field activities.
                        </p>
                    </div>

                </div>

            </div>


            <!-- CTA -->

            <a href="/weather" class="weather-main-link">


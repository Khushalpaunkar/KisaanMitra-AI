                            </p>

                        </div>

                    </div>


                    <!-- ADVICE 3 -->

                    <div class="advice-card success">

                        <div class="advice-icon">
                            ✓
                        </div>

                        <div class="advice-content">

                            <h4>
                                Good time for field work

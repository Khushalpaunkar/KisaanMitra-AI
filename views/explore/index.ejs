<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Explore/KisaanMitra AI</title>
<link rel="stylesheet" href="/css/explore.css">
<link rel="stylesheet" href="/css/navbar.css">
</head>
<body>
 <%- include('../includes/navbar') %>
<main>

  <section class="hero">
	
    </section>

  <!-- ================= SECTION 2 — AI FARMER ASSISTANT ================= -->
  <section class="section-pad section-alt">
    <div class="container">
      <div class="section-head center" style="max-width:640px; margin-left:auto; margin-right:auto;">
        <span class="eyebrow">Real Answers, Real Fast</span>
        <h2>Ask AgriBot Anything</h2>
        <p>From crop problems to farming decisions, get simple and practical answers in your preferred language.</p>
      </div>

      <div class="split">
        <div class="split-media">
          <img src="https://images.unsplash.com/photo-1627475320102-d73fcb4eb427?auto=format&fit=crop&w=800&q=80" alt="Indian farmer using a smartphone while standing in his field">
        </div>

        <div class="split-content">
          <div class="chat-card">
            <div class="chat-head">
              <div class="chat-avatar">🤖</div>
              <div>
                <div class="chat-title">AgriBot Assistant</div>
                <div class="chat-status"><span class="dot"></span> Online now</div>
              </div>
            </div>
            <div class="chat-body">
              <div class="bubble user">माझ्या कापसाच्या पानांवर डाग पडले आहेत, काय करू?</div>
              <div class="bubble bot">तुमच्या वर्णनानुसार बुरशीजन्य रोगाची शक्यता आहे. प्रभावित पाने काढा आणि योग्य उपचार वापरा.</div>
            </div>
            <div class="chat-input-row">
              <button class="chat-icon-btn" aria-label="Voice input">🎤</button>
              <div class="chat-input">Type your farming question…</div>
              <button class="chat-icon-btn chat-send" aria-label="Send message">➤</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SECTION 3 — CROP INTELLIGENCE ================= -->
  <section class="section-pad">
    <div class="container">
      <div class="split reverse">
        <div class="split-media">
          <img src="https://images.unsplash.com/photo-1633410195091-bd66114cef5f?auto=format&fit=crop&w=800&q=80" alt="Farmers inspecting crops in an agricultural field">
        </div>

        <div class="split-content">
          <span class="eyebrow">Data-Backed Decisions</span>
          <h2 style="font-size:clamp(1.9rem,3vw,2.5rem); margin-bottom:14px;">Grow the Right Crop</h2>
          <p style="color:var(--ink-soft); font-size:1.05rem; margin-bottom:28px; max-width:46ch;">Make smarter crop decisions based on soil, season, location, water availability and farming conditions.</p>

          <div class="reco-card">
            <div class="reco-grid">
              <div class="reco-field"><div class="reco-label">Location</div><div class="reco-value">Maharashtra</div></div>
              <div class="reco-field"><div class="reco-label">Soil</div><div class="reco-value">Black Soil</div></div>
              <div class="reco-field"><div class="reco-label">Season</div><div class="reco-value">Kharif</div></div>
              <div class="reco-field"><div class="reco-label">Water</div><div class="reco-value">Medium</div></div>
            </div>
            <div class="reco-list-title">Recommended Crops</div>
            <div class="crop-row">
              <div class="crop-name">Cotton</div>
              <div class="crop-bar-track"><div class="crop-bar-fill" style="width:92%;"></div></div>
              <div class="crop-score">92%</div>
            </div>
            <div class="crop-row">
              <div class="crop-name">Soybean</div>
              <div class="crop-bar-track"><div class="crop-bar-fill" style="width:81%;"></div></div>
              <div class="crop-score">81%</div>
            </div>
            <div class="crop-row">
              <div class="crop-name">Tur</div>
              <div class="crop-bar-track"><div class="crop-bar-fill" style="width:74%;"></div></div>
              <div class="crop-score">74%</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SECTION 4 — DISEASE DETECTION ================= -->
  <section class="section-pad section-alt">
    <div class="container">
      <div class="split">
        <div class="split-media">
          <img src="https://images.unsplash.com/photo-1540805656472-6f7885b3c8d7?auto=format&fit=crop&w=800&q=80" alt="Close-up of a crop leaf showing signs of disease">
        </div>

        <div class="split-content">
          <span class="eyebrow">Catch It Early</span>
          <h2 style="font-size:clamp(1.9rem,3vw,2.5rem); margin-bottom:14px;">See Crop Problems Before They Spread</h2>
          <p style="color:var(--ink-soft); font-size:1.05rem; margin-bottom:28px; max-width:46ch;">Upload a crop image and get intelligent insights about possible diseases, symptoms and treatment.</p>

          <div class="disease-card">
            <div class="disease-top">
              <div>
                <div style="font-size:0.78rem; color:var(--ink-faint); margin-bottom:4px;">Disease Detected</div>
                <div class="disease-name">Powdery Mildew</div>
              </div>
              <span class="status-badge"><span class="dot"></span> Moderate</span>
            </div>

            <div class="metric-row">
              <div class="metric-label-row"><span>Confidence</span><span>94%</span></div>
              <div class="progress-track"><div class="progress-fill" style="width:94%;"></div></div>
            </div>
            <div class="metric-row">
              <div class="metric-label-row"><span>Severity</span><span>Moderate</span></div>
              <div class="progress-track"><div class="progress-fill" style="width:58%;"></div></div>
            </div>

            <div class="treatment-title">Treatment</div>
            <ul class="treatment-list">
              <li>Remove affected leaves</li>
              <li>Improve air circulation</li>
              <li>Apply recommended treatment</li>
            </ul>

            <a href="#" class="btn btn-primary btn-sm">Scan a New Leaf</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SECTION 5 — WEATHER INTELLIGENCE ================= -->
  <section class="weather-section">
    <img src="https://images.unsplash.com/photo-1612104785310-c37ef2d48617?auto=format&fit=crop&w=1600&q=80" alt="Wide view of farmland under a partly cloudy sky">
    <div class="container">
      <span class="eyebrow" style="background:rgba(255,255,255,0.16); color:#fff;">Plan Around the Sky</span>
      <h2 style="color:#fff; font-size:clamp(1.9rem,3vw,2.5rem); margin-bottom:10px; max-width:16ch;">Know the Weather. Plan Better.</h2>
      <p style="color:rgba(255,255,255,0.85); font-size:1.05rem; margin-bottom:34px; max-width:44ch;">Stay informed about weather conditions that can affect your farming decisions.</p>

      <div class="weather-glass">
        <div class="weather-loc">Nagpur, Maharashtra</div>
        <div class="weather-temp-row">
          <div class="weather-temp">28°</div>
          <div class="weather-cond">Partly Cloudy</div>
        </div>
        <div class="weather-stats">
          <div class="weather-stat"><span class="ws-label">Humidity</span><span class="ws-value">68%</span></div>
          <div class="weather-stat"><span class="ws-label">Rain Chance</span><span class="ws-value">72%</span></div>
          <div class="weather-stat"><span class="ws-label">Wind</span><span class="ws-value">14 km/h</span></div>
        </div>
        <div class="forecast-row">
          <div class="forecast-day"><div class="fd-name">Mon</div><div class="fd-temp">29°</div></div>

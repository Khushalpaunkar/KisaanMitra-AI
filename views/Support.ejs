<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Support Us | KisaanMitra AI</title>

  <link rel="stylesheet" href="/css/support.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

  <!-- =====================================================
       ANIMATED BACKGROUND
  ====================================================== -->

  <div class="background-animation">

    <div class="gradient-blob blob-one"></div>
    <div class="gradient-blob blob-two"></div>
    <div class="gradient-blob blob-three"></div>

    <div class="grid-background"></div>

    <div class="particles">
      <span></span><span></span><span></span><span></span>
      <span></span><span></span><span></span><span></span>
      <span></span><span></span><span></span><span></span>
      <span></span><span></span><span></span><span></span>
    </div>

    <div class="leaf leaf-one">✦</div>
    <div class="leaf leaf-two">✦</div>
    <div class="leaf leaf-three">✦</div>

  </div>


  <!-- =====================================================
       NAVBAR
  ====================================================== -->
  <%- include('./includes/navbar') %>


  <main>


    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="hero-section">

      <div class="hero-content">


        <h1>
          Support Smarter Farming
          <span>with Better Technology.</span>
        </h1>

        <p class="hero-description">
          KisaanMitra AI is a student-built initiative focused on
          making agricultural information simpler, smarter and more
          accessible for Indian farmers.
        </p>

        <p class="hero-description small">
          Your feedback, ideas and collaboration can help us build
          technology around real farming needs.
        </p>

        <div class="hero-buttons">

          <a href="#feedback" class="btn-primary">
            Share Your Feedback
            <i class="bi bi-arrow-right"></i>
          </a>

          <a href="/#features" class="btn-secondary">
            Explore KisaanMitra AI
          </a>

        </div>

        <div class="hero-trust">

          <div class="trust-item">
            <i class="bi bi-shield-check"></i>
            <span>Farmer Focused</span>
          </div>

          <div class="trust-item">
            <i class="bi bi-cpu"></i>
            <span>AI Powered</span>
          </div>

          <div class="trust-item">
            <i class="bi bi-globe2"></i>
            <span>Built for India</span>
          </div>

        </div>

      </div>


      <!-- AI VISUAL -->

      <div class="hero-visual">

        <div class="visual-glow"></div>

        <div class="orbit orbit-one">
          <span class="orbit-node node-one"></span>
        </div>

        <div class="orbit orbit-two">
          <span class="orbit-node node-two"></span>
        </div>

        <div class="orbit orbit-three">
          <span class="orbit-node node-three"></span>
        </div>

        <div class="ai-core">

          <div class="core-ring"></div>

          <div class="core-icon">
            <i class="bi bi-cpu-fill"></i>
          </div>

          <div class="core-pulse"></div>

        </div>

        <div class="visual-label label-top">
          <i class="bi bi-stars"></i>
          AI Intelligence
        </div>

        <div class="visual-label label-bottom">
          <i class="bi bi-leaf-fill"></i>
          Smart Agriculture
        </div>

      </div>

    </section>


    <!-- =====================================================
         HOW YOU CAN SUPPORT
    ====================================================== -->

    <section class="support-section">

      <div class="section-heading">

        <div class="section-tag">
          <span></span>
          YOUR SUPPORT MATTERS
        </div>

        <h2>
          How You Can
          <span>Support</span>
        </h2>

        <p>
          Small contributions of ideas, feedback and collaboration
          can help us improve KisaanMitra AI.
        </p>

      </div>


      <div class="support-grid">


        <div class="support-card">

          <div class="card-number">01</div>

          <div class="card-icon">
            <i class="bi bi-lightbulb"></i>
          </div>

          <h3>Give Feedback</h3>

          <p>
            Tell us what works, what can be improved and which
            features would be useful for farmers.
          </p>

          <a href="#feedback">
            Give Feedback
            <i class="bi bi-arrow-up-right"></i>
          </a>

        </div>


        <div class="support-card">

          <div class="card-number">02</div>

          <div class="card-icon">
            <i class="bi bi-megaphone"></i>
          </div>

          <h3>Spread the Word</h3>

          <p>
            Help more farmers, students and agriculture communities
            discover KisaanMitra AI.
          </p>

          <a href="#collaborate">
            Share KisaanMitra
            <i class="bi bi-arrow-up-right"></i>
          </a>

        </div>


        <div class="support-card">

          <div class="card-number">03</div>

          <div class="card-icon">
            <i class="bi bi-tree"></i>
          </div>

          <h3>Share Farmer Needs</h3>

          <p>
            Real farming problems help us design AI features that
            are practical and meaningful.
          </p>

          <a href="#feedback">
            Share Your Need
            <i class="bi bi-arrow-up-right"></i>
          </a>

        </div>


        <div class="support-card">

          <div class="card-number">04</div>

          <div class="card-icon">
            <i class="bi bi-people"></i>
          </div>

          <h3>Collaborate With Us</h3>

          <p>
            Connect with us for agriculture, technology, research,
            education or community initiatives.
          </p>

          <a href="#collaborate">
            Let's Collaborate
            <i class="bi bi-arrow-up-right"></i>
          </a>

        </div>

      </div>

    </section>


    <!-- =====================================================
         WHY SUPPORT MATTERS
    ====================================================== -->

    <section class="why-section">

      <div class="why-content">

        <div class="section-tag">
          <span></span>
          BUILT AROUND REAL NEEDS
        </div>

        <h2>
          Technology becomes better
          <span>when it understands real problems.</span>
        </h2>

        <p>
          KisaanMitra AI is designed around practical agricultural
          needs. Feedback from farmers, students, agriculture
          communities and technology enthusiasts helps us understand
          what matters and improve the experience.
        </p>

      </div>


      <div class="why-points">

        <div class="why-point">

          <div class="point-icon">
            <i class="bi bi-flower1"></i>
          </div>

          <div>
            <h3>Real Farming Problems</h3>
            <p>Understand practical challenges faced by farmers.</p>
          </div>

        </div>


        <div class="why-point">

          <div class="point-icon">
            <i class="bi bi-robot"></i>
          </div>

          <div>
            <h3>Better AI Recommendations</h3>
            <p>Improve the usefulness of AI-based suggestions.</p>
          </div>

        </div>


        <div class="why-point">

          <div class="point-icon">
            <i class="bi bi-chat-heart"></i>
          </div>

          <div>
            <h3>Farmer-Friendly Experience</h3>
            <p>Make agricultural information easier to understand.</p>
          </div>

        </div>


        <div class="why-point">

          <div class="point-icon">
            <i class="bi bi-rocket-takeoff"></i>
          </div>

          <div>
            <h3>Continuous Innovation</h3>
            <p>Explore new technology for smarter agriculture.</p>
          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         BUILD BETTER
    ====================================================== -->

    <section class="future-section">

      <div class="section-heading">

        <div class="section-tag">
          <span></span>
          FUTURE IMPROVEMENTS
        </div>

        <h2>
          Help Us
          <span>Build Better.</span>
        </h2>

        <p>
          Your ideas can shape the next version of KisaanMitra AI.
        </p>

      </div>


      <div class="future-grid">

        <div class="future-card">
          <i class="bi bi-bar-chart-line"></i>
          <span>Smarter Crop Intelligence</span>
        </div>

        <div class="future-card">
          <i class="bi bi-cloud-sun"></i>
          <span>Personalized Weather Insights</span>
        </div>

        <div class="future-card">
          <i class="bi bi-bug"></i>
          <span>Better Disease Detection</span>
        </div>

        <div class="future-card">
          <i class="bi bi-graph-up-arrow"></i>
          <span>Market Intelligence</span>
        </div>

        <div class="future-card">
          <i class="bi bi-bank"></i>
          <span>Government Scheme Assistance</span>
        </div>

        <div class="future-card">
          <i class="bi bi-translate"></i>
          <span>Marathi & Regional Languages</span>
        </div>

        <div class="future-card">
          <i class="bi bi-person-check"></i>
          <span>Personalized AI Recommendations</span>
        </div>

        <div class="future-card">
          <i class="bi bi-tools"></i>
          <span>Farmer-Centric Tools</span>
        </div>

      </div>

    </section>


    <!-- =====================================================
         FEEDBACK
    ====================================================== -->

    <section class="feedback-section" id="feedback">

      <div class="feedback-wrapper">

        <div class="feedback-info">

          <div class="section-tag">
            <span></span>
            SHARE YOUR EXPERIENCE
          </div>

          <h2>
            Your Experience
            <span>Matters.</span>
          </h2>

          <p>
            Have you explored KisaanMitra AI? Tell us what you
            think and what you would like us to improve.
          </p>

          <div class="feedback-highlight">

            <div class="highlight-icon">
              <i class="bi bi-chat-square-heart"></i>
            </div>

            <div>
              <strong>Your voice helps us improve.</strong>
              <span>
                Every useful suggestion can inspire a better
                farming experience.
              </span>
            </div>

          </div>

        </div>


        <div class="feedback-form-container">

          <form action="/feedback/submit" method="POST" class="feedback-form">

            <div class="form-row">

              <div class="form-group">
                <label for="name">Name</label>

                <div class="input-box">
                  <i class="bi bi-person"></i>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Enter your name"
                    required>
                </div>
              </div>


              <div class="form-group">
                <label for="email">Email</label>

                <div class="input-box">
                  <i class="bi bi-envelope"></i>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your email"
                    required>
                </div>
              </div>

            </div>


            <div class="form-row">

              <div class="form-group">
                <label for="userType">User Type</label>

                <div class="input-box">
                  <i class="bi bi-people"></i>

                  <select id="userType" name="userType" required>
                    <option value="">Select user type</option>
                    <option>Farmer</option>
                    <option>Student</option>
                    <option>Agriculture Professional</option>
                    <option>Visitor</option>
                    <option>Other</option>
                  </select>

                </div>
              </div>


              <div class="form-group">
                <label for="location">Location</label>

                <div class="input-box">
                  <i class="bi bi-geo-alt"></i>

                  <input
                    type="text"
                    id="location"
                    name="location"
                    placeholder="City / Village">
                </div>

              </div>


              <div class="form-group">

                <label for="feature">Feature Used</label>

                <div class="input-box">
                  <i class="bi bi-grid"></i>

                  <select id="feature" name="feature">
                    <option value="">Select feature</option>
                    <option>AI Chatbot</option>
                    <option>Weather</option>
                    <option>Crop Intelligence</option>
                    <option>Disease Detection</option>
                    <option>Market</option>
                    <option>Government Schemes</option>
                    <option>Other</option>
                  </select>

                </div>

              </div>

            </div>


            <div class="form-group">

              <label>How was your experience?</label>

              <div class="rating">

                <label>
                  <input type="radio" name="rating" value="1">
                  <span>1</span>
                </label>

                <label>
                  <input type="radio" name="rating" value="2">
                  <span>2</span>
                </label>

                <label>
                  <input type="radio" name="rating" value="3">
                  <span>3</span>
                </label>

                <label>
                  <input type="radio" name="rating" value="4">
                  <span>4</span>
                </label>

                <label>
                  <input type="radio" name="rating" value="5">
                  <span>5</span>
                </label>

              </div>

            </div>


            <div class="form-group">

              <label for="message">Suggestion / Message</label>

              <div class="textarea-box">

                <i class="bi bi-pencil"></i>

                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  placeholder="Tell us your thoughts or suggestions..."
                  required></textarea>

              </div>

            </div>


            <button type="submit" class="submit-btn">

              Submit Feedback

              <i class="bi bi-arrow-up-right"></i>

            </button>

          </form>

        </div>

      </div>

    </section>


    <!-- =====================================================
         COLLABORATION
    ====================================================== -->

    <section class="collaboration-section" id="collaborate">

      <div class="collaboration-glow"></div>

      <div class="collaboration-content">

        <div class="collab-icon">
          <i class="bi bi-diagram-3"></i>
        </div>

        <div class="section-tag center-tag">
          <span></span>
          COLLABORATION
          <span></span>
        </div>

        <h2>
          Let's Build for Farmers,
          <span>Together.</span>
        </h2>

        <p>
          We welcome ideas, feedback and meaningful collaboration
          from students, developers, agriculture enthusiasts,
          researchers and communities interested in using
          technology for agriculture.
        </p>

       <a
  href="mailto:kisaanmitraai@gmail.com?subject=KisaanMitra%20AI%20-%20Collaboration%20Inquiry&body=Hello%20KisaanMitra%20AI%20Team%2C%0A%0AI%20would%20like%20to%20discuss%20a%20collaboration%20opportunity.%0A%0AThank%20you."
  class="btn btn-primary"
>
  <i class="fa-solid fa-envelope-circle-check"></i>
  Start Conversation
</a>

      </div>

    </section>


    <!-- =====================================================
         FINAL CTA
    ====================================================== -->

    <section class="final-cta">

      <div class="cta-pattern"></div>

      <div class="cta-content">

        <div class="cta-icon">
          <i class="bi bi-flower1"></i>
        </div>

        <h2>
          Let's Make Farming
          <span>Smarter, Together.</span>
        </h2>

        <p>
          Your feedback, ideas and support can help us take
          KisaanMitra AI one step closer to becoming a more useful
          digital companion for farmers.
        </p>

        <div class="cta-buttons">

          <a href="#feedback" class="btn-light">
            Support KisaanMitra
            <i class="bi bi-arrow-right"></i>
          </a>

          <a href="/#features" class="btn-outline-light">
            Explore Features
          </a>

        </div>

      </div>

    </section>

  </main>


  <%- include('./includes/footer') %>


  <!-- Small mobile navigation functionality -->
  <script>
    const menuBtn = document.querySelector(".mobile-menu");
    const navLinks = document.querySelector(".nav-links");

    if (menuBtn) {
      menuBtn.addEventListener("click", () => {
        navLinks.classList.toggle("mobile-open");
      });
    }
  </script>

  <script>
  const urlParams = new URLSearchParams(window.location.search);

  if (urlParams.get("feedback") === "success") {
    alert("Thank you for your feedback! Your response has been successfully submitted.");

    // URL मधून ?feedback=success remove करणे
    window.history.replaceState({}, document.title, "/support");
  }

  if (urlParams.get("feedback") === "error") {
    alert("Something went wrong. Please try again later.");

    window.history.replaceState({}, document.title, "/support");
  }
</script>

</body>
</html>
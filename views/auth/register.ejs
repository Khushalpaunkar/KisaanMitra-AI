<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account </title>
    <link rel="stylesheet" href="/css/register.css">
</head>
<body>
    <div class="signup-page">

    <!-- Left Brand Section -->
    <section class="brand-section">

        <div class="brand-content">
            <div class="brand-logo">
                <img src="/images/bot-img.png">
            </div>

            <h1>
                Your Farm.<br>
                Your <span>AI Mitra.</span>
            </h1>

            <p>
                Create your account and get personalized,
                intelligent farming guidance designed for
                Indian farmers.
            </p>
        </div>

    </section>


    <!-- Right Signup Section -->
    <section class="signup-section">

        <div class="signup-card">

            <div class="form-header">
                <span class="welcome">Welcome to KisaanMitra</span>

                <h2>Create your account</h2>

                <p>
                    Start your journey with your digital farming companion.
                </p>
            </div>


            <form action="/auth/register" method="POST">

                <!-- Full Name -->
                <div class="input-group">
                    <label for="name">Full Name</label>

                    <div class="input-box">
                        <span class="input-icon">👤</span>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Enter your full name"
                            required
                        >
                    </div>
                </div>


                <!-- Mobile Number -->
                <div class="input-group">
                    <label for="mobile">Mobile Number</label>

                    <div class="input-box">
                        <span class="input-icon">📱</span>
                        <input
                            type="tel"
                            id="mobile"
                            name="mobile"
                            placeholder="Enter mobile number"
                            maxlength="10"
                            required
                        >
                    </div>
                </div>


                <!-- Address -->
                <div class="input-group">
                    <label for="address">Village / Address</label>

                    <div class="input-box textarea-box">
                        <span class="input-icon">📍</span>

                        <textarea
                            id="address"
                            name="address"
                            placeholder="Enter your village or address"
                            rows="2"
                            required
                        ></textarea>
                    </div>
                </div>
                
                <!-- State -->
<!-- State -->
<div class="input-group">
    <label for="state">State</label>

    <div class="input-box">
        <span class="input-icon">🗺️</span>

        <select id="state" name="state" required>
            <option value="" disabled selected>Select your state</option>
            <option value="Maharashtra">Maharashtra</option>
            <option value="Madhya Pradesh">Madhya Pradesh</option>
            <option value="Gujarat">Gujarat</option>
            <option value="Rajasthan">Rajasthan</option>
            <option value="Karnataka">Karnataka</option>
            <option value="Telangana">Telangana</option>
            <option value="Andhra Pradesh">Andhra Pradesh</option>
            <option value="Uttar Pradesh">Uttar Pradesh</option>
            <option value="Punjab">Punjab</option>
            <option value="Haryana">Haryana</option>
            <option value="Bihar">Bihar</option>
            <option value="Chhattisgarh">Chhattisgarh</option>
            <option value="Odisha">Odisha</option>
            <option value="West Bengal">West Bengal</option>
            <option value="Tamil Nadu">Tamil Nadu</option>
            <option value="Kerala">Kerala</option>
            <option value="Jharkhand">Jharkhand</option>
            <option value="Assam">Assam</option>
            <option value="Other">Other</option>
        </select>
    </div>
</div>

                <!-- PIN -->
                <div class="input-group">
                    <label for="pin">Create 4-digit PIN</label>

                    <div class="input-box">
                        <span class="input-icon">🔒</span>

                        <input
                            type="password"
                            id="pin"
                            name="password"
                            placeholder="Enter 4-digit PIN"
                            maxlength="4"
                            inputmode="numeric"
                            required
                        >
                    </div>
                </div>


                <!-- Confirm PIN -->
                <div class="input-group">
                    <label for="confirmPin">Confirm PIN</label>

                    <div class="input-box">
                        <span class="input-icon">🔐</span>

                        <input
                            type="password"
                            id="confirmPin"
                            name="confirmPassword"
                            placeholder="Re-enter your PIN"
                            maxlength="4"
                            inputmode="numeric"
                            required
                        >
                    </div>
                </div>


                <button type="submit" class="create-btn">
                    Create Account
                    <span>→</span>
                </button>

            </form>


            <div class="login-link">
                Already have an account?
                <a href="/login">Login</a>
            </div>

        </div>

    </section>

</div>
</body>
</html>
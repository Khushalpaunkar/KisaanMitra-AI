<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>KisaanMitra AI — Government Schemes</title>

  <link rel="stylesheet" href="/css/schemes.css" />
  <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
</head>

<body>

  <!-- =====================================================
       NAVBAR
  ====================================================== -->
  <%- include('../includes/navbar') %>


  <!-- =====================================================
       HERO
  ====================================================== -->
  <section class="scheme-hero">

    <div class="hero-glow hero-glow-1"></div>
    <div class="hero-glow hero-glow-2"></div>

    <div class="hero-leaf leaf-1">🌿</div>
    <div class="hero-leaf leaf-2">🍃</div>
    <div class="hero-leaf leaf-3">🌱</div>

    <div class="scheme-container hero-content">

      <div class="hero-badge">
        <span class="pulse-dot"></span>
        Government Farmer Schemes
      </div>

      <h1>
        सरकारी योजनांचा लाभ
        <span>तुमच्या शेतीसाठी</span>
      </h1>

      <p>
        तुमच्या शेतीची माहिती आणि गरजेनुसार योग्य सरकारी योजना शोधा,
        पात्रता समजून घ्या आणि अर्ज करण्याची प्रक्रिया सोप्या भाषेत जाणून घ्या.
      </p>

      <div class="hero-actions">
        <button class="primary-btn" onclick="window.location.href='/findschemes'">
          <i class="fa-solid fa-wand-magic-sparkles"></i>
          Find Schemes For Me
        </button>

        <button class="secondary-btn" onclick="scrollToSchemes()">
          <i class="fa-solid fa-list"></i>
          Explore Schemes
        </button>
      </div>

      <div class="hero-trust">
        <span><i class="fa-solid fa-shield-halved"></i> Official Sources</span>
        <span><i class="fa-solid fa-language"></i> Marathi Friendly</span>
        <span><i class="fa-solid fa-mobile-screen"></i> Mobile Friendly</span>
      </div>

    </div>
  </section>


  <!-- =====================================================
       QUICK NEEDS
  ====================================================== -->
  
   <section class="quick-section">

  <div class="scheme-container">


<!-- Section Header -->
<div class="section-heading">

  <span class="section-label">FIND THE RIGHT SCHEME</span>

  <h2>
    तुमच्या गरजेनुसार
    <span>योजना शोधा</span>
  </h2>

  <p class="section-description">
    योजनेचे नाव माहित नसले तरी काळजी करू नका.
    तुमची गरज निवडा आणि तुमच्यासाठी उपलब्ध असलेल्या
    सरकारी योजनांची माहिती मिळवा.
  </p>

  <div class="scheme-info">
    <span>✓</span>
    <span>केंद्र व महाराष्ट्र शासनाच्या योजना</span>

    <span>✓</span>
    <span>शेतकऱ्यांसाठी सोपी माहिती</span>

    <span>✓</span>
    <span>पात्रता व लाभ समजून घ्या</span>
  </div>

</div>


<!-- Need Categories -->
<div class="need-grid">

  <!-- Financial -->
  <button class="need-card" data-need="financial">

    <div class="need-icon">💰</div>

    <div class="need-content">
      <strong>आर्थिक मदत</strong>
      <small>Financial Support</small>

      <p>
        शेतकऱ्यांना आर्थिक सहाय्य,
        अनुदान किंवा थेट लाभ मिळवण्यासाठी.
      </p>
    </div>

    <span class="card-arrow">→</span>

  </button>


  <!-- Insurance -->
  <button class="need-card" data-need="insurance">

    <div class="need-icon">🛡️</div>

    <div class="need-content">
      <strong>पीक विमा</strong>
      <small>Crop Insurance</small>

      <p>
        नैसर्गिक आपत्ती किंवा पिकाचे नुकसान
        झाल्यास आर्थिक संरक्षणासाठी.
      </p>
    </div>

    <span class="card-arrow">→</span>

  </button>


  <!-- Loan -->
  <button class="need-card" data-need="loan">

    <div class="need-icon">🏦</div>

    <div class="need-content">
      <strong>कर्ज / Loan</strong>
      <small>Credit Support</small>

      <p>
        शेतीसाठी कर्ज, कमी व्याजदर आणि
        आर्थिक सुविधा मिळवण्यासाठी.
      </p>
    </div>

    <span class="card-arrow">→</span>

  </button>


  <!-- Equipment -->
  <button class="need-card" data-need="equipment">

    <div class="need-icon">🚜</div>

    <div class="need-content">
      <strong>शेती उपकरणे</strong>
      <small>Farm Equipment</small>

      <p>
        ट्रॅक्टर, अवजारे व आधुनिक शेती
        उपकरणांसाठी अनुदान व मदत.
      </p>
    </div>

    <span class="card-arrow">→</span>

  </button>


  <!-- Irrigation -->
  <button class="need-card" data-need="irrigation">

    <div class="need-icon">💧</div>

    <div class="need-content">
      <strong>सिंचन</strong>
      <small>Irrigation</small>

      <p>
        ठिबक, तुषार आणि इतर सिंचन
        सुविधांसाठी सरकारी सहाय्य.
      </p>
    </div>

    <span class="card-arrow">→</span>

  </button>


  <!-- Seeds -->
  <button class="need-card" data-need="seeds">

    <div class="need-icon">🌱</div>

    <div class="need-content">
      <strong>बियाणे / Inputs</strong>
      <small>Seeds & Inputs</small>

      <p>
        दर्जेदार बियाणे, खते आणि शेती
        निविष्ठांसाठी उपलब्ध योजनांसाठी.
      </p>
    </div>

    <span class="card-arrow">→</span>

  </button>


  <!-- Livestock -->
  <button class="need-card" data-need="livestock">

    <div class="need-icon">🐄</div>

    <div class="need-content">
      <strong>पशुपालन</strong>
      <small>Livestock</small>

      <p>
        गाय, म्हैस, शेळी, कुक्कुटपालन आणि
        पशुधनासाठी सरकारी सहाय्य.
      </p>
    </div>

    <span class="card-arrow">→</span>

  </button>


  <!-- Horticulture -->
  <button class="need-card" data-need="horticulture">

    <div class="need-icon">🥭</div>

    <div class="need-content">
      <strong>फळबाग</strong>
      <small>Horticulture</small>

      <p>
        फळबाग लागवड, रोपे आणि
        बागायती विकासासाठी मदत.
      </p>
    </div>

    <span class="card-arrow">→</span>

  </button>

</div>


<!-- Bottom Helper -->
<div class="scheme-helper">

  <div class="helper-icon">🌾</div>

  <div>
    <strong>योजना कुठून सुरू करावी हे समजत नाही?</strong>

    <p>
      तुमची गरज निवडा. आम्ही संबंधित योजनांची
      पात्रता, लाभ, आवश्यक कागदपत्रे आणि अर्जाची
      माहिती समजण्यास सोप्या भाषेत दाखवू.
    </p>
  </div>

</div>

  </div>

</section>


  <!-- =====================================================
       GOVERNMENT SWITCHER
  ====================================================== -->
  


  <!-- =====================================================
       SCHEME FINDER
  ====================================================== -->
   <section class="ai-finder-section">

  <div class="ai-finder-container">

    <div class="ai-finder-card">

      <!-- LEFT CONTENT -->
      <div class="ai-finder-content">

        <span class="ai-finder-badge">
          KISAANMITRA AI
        </span>

        <h2 class="ai-finder-title">
          तुमच्यासाठी योग्य
          <span>सरकारी योजना शोधा</span>
        </h2>

        <p class="ai-finder-description">
          प्रत्येक शेतकऱ्याची शेती, गरज आणि परिस्थिती वेगळी असते.
          तुमची शेती आणि गरज याबद्दल काही माहिती द्या आणि
          KisaanMitra AI तुमच्यासाठी संबंधित सरकारी योजना
          शोधण्यात मदत करेल.
        </p>

        <div class="ai-finder-features">

          <div class="ai-finder-feature">
            <i class="fa-solid fa-location-dot"></i>
            <div>
              <strong>तुमचे स्थान</strong>
              <small>State, District, Taluka & Village</small>
            </div>
          </div>

          <div class="ai-finder-feature">
            <i class="fa-solid fa-wheat-awn"></i>
            <div>
              <strong>तुमची शेती</strong>
              <small>Crop, Land & Irrigation</small>
            </div>
          </div>

          <div class="ai-finder-feature">
            <i class="fa-solid fa-bullseye"></i>
            <div>
              <strong>तुमची गरज</strong>
              <small>Financial, Insurance, Loan & More</small>
            </div>
          </div>

        </div>

        <a href="/findschemes" class="ai-finder-btn">
          <span>
            Find Schemes For Me
          </span>

          <i class="fa-solid fa-arrow-right"></i>
        </a>

        <small class="ai-finder-note">
          <i class="fa-solid fa-shield-heart"></i>
          तुमची माहिती सुरक्षितपणे वापरून संबंधित योजना शोधण्यात मदत केली जाते.
        </small>

      </div>


      <!-- RIGHT VISUAL -->
      <div class="ai-finder-visual">

        <div class="ai-orbit orbit-one"></div>
        <div class="ai-orbit orbit-two"></div>

        <div class="ai-main-icon">
          <div class="ai-icon-glow"></div>
         <i class="fa-solid fa-sun-plant-wilt"></i>
        </div>

        <div class="floating-scheme scheme-one">
          <span>💰</span>
          <div>
            <strong>Financial Support</strong>
            <small>Scheme Match</small>
          </div>
        </div>

        <div class="floating-scheme scheme-two">
          <span>🛡️</span>
          <div>
            <strong>Crop Insurance</strong>
            <small>Eligible Schemes</small>
          </div>
        </div>

        <div class="floating-scheme scheme-three">
          <span>🚜</span>
          <div>
            <strong>Farm Equipment</strong>
            <small>Government Support</small>
          </div>
        </div>

        <div class="ai-match-card">
          <i class="fa-solid fa-circle-check"></i>
          <div>
            <strong>AI Scheme Matching</strong>
            <span>Based on your farm profile</span>
          </div>
        </div>

      </div>

    </div>

  </div>

</section>



  <!-- =====================================================
       ALL SCHEMES
  ====================================================== -->
  <section class="all-schemes-section" id="allSchemes">

    <div class="scheme-container">

      <div class="section-heading">

        <span class="section-label">EXPLORE GOVERNMENT SUPPORT</span>

        <h2>
          All Farmer
          <span>Schemes</span>
        </h2>

        <p>
          उपलब्ध योजनांचा शोध घ्या आणि तुमच्यासाठी संबंधित योजना save करा.
        </p>

      </div>


      <!-- SEARCH -->
      <div class="scheme-toolbar">

        <div class="scheme-search">

          <i class="fa-solid fa-magnifying-glass"></i>

          <input
            type="text"
            id="schemeSearch"
            placeholder="Search schemes..."
          />

        </div>


        <select id="categoryFilter">
          <option value="all">All Categories</option>
          <option value="financial">Financial</option>
          <option value="insurance">Insurance</option>
          <option value="loan">Loan</option>
          <option value="equipment">Equipment</option>
          <option value="irrigation">Irrigation</option>
          <option value="seeds">Seeds / Inputs</option>
          <option value="livestock">Livestock</option>
          <option value="horticulture">Horticulture</option>
        </select>


        <select id="statusFilter">
          <option value="all">All Status</option>
          <option value="available">Currently Available</option>
          <option value="seasonal">Seasonal</option>
        </select>

      </div>


      <div class="scheme-grid" id="schemeGrid">

        <!-- JS populated -->

      </div>

      <div class="schemes-explore-wrap view-all-wrap" id="viewAllWrap">
        <a href="/allschemes" class="explore-all-btn view-all-btn" id="viewAllBtn">
          View All Schemes <span aria-hidden="true">→</span>
        </a>
      </div>


      <div class="empty-state" id="emptyState">

        <div>🌾</div>

        <h3>No schemes found</h3>

        <p>
          Search किंवा filter बदलून पुन्हा प्रयत्न करा.
        </p>

        <button class="outline-btn" onclick="clearFilters()">
          Clear Filters
        </button>

      </div>

    </div>

  </section>


  <!-- =====================================================
       SAVED SCHEMES
  ====================================================== -->
  <section class="saved-section">

    <div class="scheme-container">

      <div class="saved-banner">

        <div class="saved-icon">
          <i class="fa-solid fa-bookmark"></i>
        </div>

        <div>
          <span class="section-label">YOUR COLLECTION</span>

          <h3>Saved Schemes</h3>

          <p>
            महत्त्वाच्या योजना नंतर पाहण्यासाठी save करा.
          </p>
        </div>

        <div class="saved-count">
          <span id="savedCount">0</span>
          <small>Saved</small>
        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       COMPARE
  ====================================================== -->
  <section class="compare-section">

    <div class="scheme-container">

      <div class="section-heading">

        <span class="section-label">MAKE IT SIMPLE</span>

        <h2>
          Compare
          <span>Schemes</span>
        </h2>

        <p>
          दोन किंवा अधिक योजनांची माहिती एकाच ठिकाणी compare करा.
        </p>

      </div>


      <div class="compare-card">

        <div class="compare-empty" id="compareEmpty">

          <div class="compare-icon">
            <i class="fa-solid fa-scale-balanced"></i>
          </div>

          <h3>Select schemes to compare</h3>

          <p>
            Scheme card वर Compare option निवडा.
          </p>

        </div>


        <div class="compare-table-wrap" id="compareTableWrap">

          <table>

            <thead>
              <tr>
                <th>Feature</th>
                <th id="compareName1">Scheme 1</th>
                <th id="compareName2">Scheme 2</th>
                <th id="compareName3">Scheme 3</th>
              </tr>
            </thead>

            <tbody>

              <tr>
                <td>Category</td>
                <td id="compareCategory1">—</td>
                <td id="compareCategory2">—</td>
                <td id="compareCategory3">—</td>
              </tr>

              <tr>
                <td>Government</td>
                <td id="compareGov1">—</td>
                <td id="compareGov2">—</td>
                <td id="compareGov3">—</td>
              </tr>

              <tr>
                <td>Benefit</td>
                <td id="compareBenefit1">—</td>
                <td id="compareBenefit2">—</td>
                <td id="compareBenefit3">—</td>
              </tr>

              <tr>
                <td>Eligibility</td>
                <td id="compareEligibility1">—</td>
                <td id="compareEligibility2">—</td>
                <td id="compareEligibility3">—</td>
              </tr>

              <tr>
                <td>Documents</td>
                <td id="compareDocs1">—</td>
                <td id="compareDocs2">—</td>
                <td id="compareDocs3">—</td>
              </tr>

            </tbody>

          </table>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       FAQ
  ====================================================== -->
  <section class="faq-section">

    <div class="scheme-container">

      <div class="section-heading">

        <span class="section-label">HELP CENTER</span>

        <h2>
          Frequently Asked
          <span>Questions</span>
        </h2>

      </div>


      <div class="faq-list">

        <div class="faq-item">

          <button class="faq-question">
            योजना शोधण्यासाठी मला कोणती माहिती द्यावी लागेल?
            <i class="fa-solid fa-plus"></i>
          </button>

          <div class="faq-answer">
            <p>
              तुमचे स्थान, शेतीचे क्षेत्र, जमीन प्रकार, मुख्य पीक,
              सिंचन आणि तुम्हाला कोणत्या प्रकारची मदत हवी आहे
              एवढी प्राथमिक माहिती पुरेशी आहे.
            </p>
          </div>

        </div>


        <div class="faq-item">

          <button class="faq-question">
            KisaanMitra AI योजना स्वतः approve करते का?
            <i class="fa-solid fa-plus"></i>
          </button>

          <div class="faq-answer">
            <p>
              नाही. KisaanMitra AI फक्त संबंधित योजना आणि
              उपलब्ध माहिती समजून घेण्यास मदत करते.
              अंतिम पात्रता आणि मंजुरी संबंधित सरकारी विभागाच्या
              नियमांनुसार होते.
            </p>
          </div>

        </div>


        <div class="faq-item">

          <button class="faq-question">
            मला योजनेची माहिती कुठून मिळते?
            <i class="fa-solid fa-plus"></i>
          </button>

          <div class="faq-answer">
            <p>
              शक्य तिथे अधिकृत सरकारी स्रोत आणि संबंधित विभागाच्या
              माहितीवर आधारित scheme data वापरण्याचा उद्देश आहे.
            </p>
          </div>

        </div>


        <div class="faq-item">

          <button class="faq-question">
            योजना save करून नंतर पाहू शकतो का?
            <i class="fa-solid fa-plus"></i>
          </button>

          <div class="faq-answer">
            <p>
              हो. Scheme card वरील bookmark button वापरून
              योजना save करता येते.
            </p>
          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       SCHEME DETAIL MODAL
  ====================================================== -->
  <div class="scheme-modal" id="schemeModal">

    <div class="modal-overlay" id="modalOverlay"></div>

    <div class="scheme-modal-box">

      <button class="modal-close" id="modalClose">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <div class="modal-header">

        <div class="modal-scheme-icon" id="modalIcon">
          🌾
        </div>

        <div>

          <span class="modal-category" id="modalCategory">
            Scheme
          </span>

          <h2 id="modalTitle">
            Scheme Name
          </h2>

          <p id="modalGovernment">
            Government
          </p>

        </div>

      </div>


      <div class="modal-content">

        <div class="modal-highlight">

          <span>Benefit / Support</span>

          <strong id="modalBenefit">
            —
          </strong>

        </div>


        <div class="modal-section">

          <h3>
            <i class="fa-solid fa-circle-info"></i>
            About This Scheme
          </h3>

          <p id="modalDescription">
            —
          </p>

        </div>


        <div class="modal-section">

          <h3>
            <i class="fa-solid fa-user-check"></i>
            Eligibility
          </h3>

          <ul id="modalEligibility"></ul>

        </div>


        <div class="modal-section">

          <h3>
            <i class="fa-solid fa-file-lines"></i>
            Documents
          </h3>

          <ul id="modalDocuments"></ul>

        </div>


        <div class="modal-section">

          <h3>
            <i class="fa-solid fa-list-check"></i>
            Application Steps
          </h3>

          <div class="application-steps" id="modalSteps"></div>

        </div>


        <div class="official-card">

          <div class="official-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <div>

            <strong>Verify from Official Source</strong>

            <p>
              अर्ज करण्यापूर्वी अधिकृत सरकारी पोर्टलवर
              नवीनतम माहिती आणि पात्रता तपासा.
            </p>

          </div>

          <div class="official-actions">
            <a
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              id="modalOfficialLink"
            >
              Official Website
              <i class="fa-solid fa-arrow-up-right-from-square"></i>
            </a>
            <a
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              id="modalApplyLink"
              class="modal-apply-link"
            >
              Apply Now
              <i class="fa-solid fa-arrow-up-right-from-square"></i>
            </a>
          </div>

        </div>

      </div>

    </div>

  </div>


  <!-- =====================================================
       TOAST
  ====================================================== -->
  <div class="scheme-toast" id="schemeToast">
    <i class="fa-solid fa-circle-check"></i>
    <span id="toastMessage">Saved</span>
  </div>


  <%- include ('../includes/footer') %>

  <script>
    window.kisaanmitraSchemes = <%- JSON.stringify(schemes || []) %>;
  </script>
  <script src="/js/schemes.js"></script>
  <script>
    (() => {
      const openSchemeModal = window.openSchemeModal;
      if (typeof openSchemeModal !== "function") return;

      window.openSchemeModal = (id) => {
        openSchemeModal(id);

        const scheme = (window.kisaanmitraSchemes || []).find(
          (item) => String(item.id || item.slug || item._id || "") === String(id)
        );
        const applyLink = document.getElementById("modalApplyLink");
        if (!scheme || !applyLink) return;

        try {
          const url = new URL(
            scheme.applyUrl || scheme.officialUrl || scheme.sourceUrl || "#",
            window.location.origin
          );
          applyLink.href = ["http:", "https:"].includes(url.protocol) ? url.href : "#";
        } catch {
          applyLink.href = "#";
        }
      };
    })();
  </script>

</body>
</html>
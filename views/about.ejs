  <%- include ("includes/footer") %>

  <script>
    // Generate floating particles
    (function () {
      var container = document.getElementById('particles');
      if (!container) return;
      var count = 40;
      for (var i = 0; i < count; i++) {
        var dot = document.createElement('div');
        dot.className = 'particle';
        var size = Math.random() * 4 + 1;
        dot.style.width = size + 'px';
        dot.style.height = size + 'px';
        dot.style.left = Math.random() * 100 + '%';
        dot.style.top = Math.random() * 100 + '%';
        dot.style.animationDuration = (Math.random() * 20 + 15) + 's';
        dot.style.animationDelay = (Math.random() * 10) + 's';
        dot.style.opacity = Math.random() * 0.5 + 0.1;
        container.appendChild(dot);
      }
    })();

    // Intersection Observer for scroll-triggered animations
    (function () {
      var animEls = document.querySelectorAll(
        '.anim-fade-up, .anim-fade-in, .anim-fade-left, .anim-fade-right, .anim-scale-in, .anim-pop-in, .creator-heading, .section-heading .eyebrow, .vision-section .eyebrow'
      );

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('anim-visible');
            observer.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.15,
        rootMargin: '0px 0px -40px 0px'
      });

      animEls.forEach(function (el) {
        observer.observe(el);
      });

      // Hero section immediate reveal on load
      setTimeout(function () {
        document.querySelector('.hero-content').classList.add('hero-visible');
        document.querySelector('.hero-visual').classList.add('hero-visible');
      }, 100);
    })();
  </script>

